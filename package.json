{
  "name": "samguk-online",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "지인들과 함께하는 비동기 주사위 영토 전략 게임",
  "scripts": {
    "build": "node tools/build.mjs",
    "dev": "node tools/serve.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:rules": "firebase emulators:exec --project demo-samguk-online --only database \"node --test tests-rules/*.test.mjs\"",
    "emulators": "firebase emulators:start --project demo-samguk-online --only auth,database"
  },
  "dependencies": {
    "d3": "7.9.0",
    "firebase": "12.4.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.0",
    "esbuild": "^0.25.0",
    "firebase-tools": "^14.0.0"
  },
  "engines": { "node": ">=22" },
  "license": "GPL-3.0-only"
}
